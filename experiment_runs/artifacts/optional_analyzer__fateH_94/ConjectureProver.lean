lemma isIntegral_quotient_annihilator {R S M : Type} [CommRing R] [CommRing S] [AddCommGroup M]
    [Algebra R S] [Module S M] [Module R M] [IsScalarTower R S M] [Algebra.IsIntegral R S] :
    @Algebra.IsIntegral (R ⧸ Module.annihilator R M) (S ⧸ Module.annihilator S M) _ _
      (annihilatorQuotientAlgebra R S M) := by
  let I : Ideal S := Module.annihilator S M
  let J : Ideal R := Module.annihilator R M
  let f : R →+* S := algebraMap R S
  have hJ : I.comap f = J := annihilator_comap
  have hf : f.IsIntegral := fun x => (inferInstance : Algebra.IsIntegral R S).isIntegral x
  have hq : (Ideal.quotientMap I f le_rfl).IsIntegral := by
    simpa using (RingHom.IsIntegral.quotient f hf)
  let e : (R ⧸ I.comap f) ≃+* (R ⧸ J) := Ideal.quotEquivOfEq hJ
  have he : e.symm.toRingHom.IsIntegral :=
    RingHom.isIntegral_of_surjective e.symm.toRingHom e.symm.surjective
  have hcomp : ((Ideal.quotientMap I f le_rfl).comp e.symm.toRingHom).IsIntegral :=
    RingHom.IsIntegral.trans e.symm.toRingHom (Ideal.quotientMap I f le_rfl) he hq
  have hmap : Ideal.quotientMap I f (le_of_eq hJ.symm) =
      (Ideal.quotientMap I f le_rfl).comp e.symm.toRingHom := by
    apply RingHom.ext
    intro x
    rcases Ideal.Quotient.mk_surjective x with ⟨r, rfl⟩
    dsimp [e]
    simp [Ideal.quotientMap_mk, Ideal.quotEquivOfEq_symm, Ideal.quotEquivOfEq_mk]
  have htarget : (Ideal.quotientMap I f (le_of_eq hJ.symm)).IsIntegral := by
    simpa [hmap] using hcomp
  exact @Algebra.IsIntegral.mk (R ⧸ J) (S ⧸ I) _ _ (annihilatorQuotientAlgebra R S M) htarget

