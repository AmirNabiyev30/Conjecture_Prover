@[blueprint
  (statement := /-- If `Algebra.IsIntegral A B`, then `ringKrullDim B ≤ ringKrullDim A`. -/)
  (hasProof := true)
  (proof := /-- Chain contraction: the comap along `algebraMap A B` maps chains of primes of $B$ to chains of primes of $A$ (strictness of the contraction for integral extensions), hence `Order.krullDim (PrimeSpectrum B) ≤ Order.krullDim (PrimeSpectrum A)`. -/)
  (proofUses := [])
  (title := /-- Dimension of an integral extension is at most the base -/)
]
lemma ringKrullDim_le_of_isIntegral {A B : Type} [CommRing A] [CommRing B] [Algebra A B]
    [Algebra.IsIntegral A B] : ringKrullDim B ≤ ringKrullDim A := by
  rw [ringKrullDim, ringKrullDim]
  refine Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap A B)) ?_
  intro 𝔮₁ 𝔮₂ hlt
  exact (PrimeSpectrum.asIdeal_lt_asIdeal _ _).1
    (Ideal.IsIntegral.comap_lt_comap (I := 𝔮₁.asIdeal) (J := 𝔮₂.asIdeal)
      ((PrimeSpectrum.asIdeal_lt_asIdeal _ _).2 hlt))

