/--
**Main theorem: `ringKrullDim_quot_annihilator_eq`**.

Suppose that a ring $S$ is integral over the image of a ring homomorphism $R \to S$. Then the
Krull dimension of $M$ as an $S$-module is the same as the Krull dimension of $M$ as an
$R$-module, i.e.
$$\dim\!\big(S / \operatorname{Ann}_S(M)\big) = \dim\!\big(R / \operatorname{Ann}_R(M)\big).$$
-/
@[blueprint
  (statement := /-- For `[Algebra R S] [Module S M] [Module R M] [IsScalarTower R S M] [Algebra.IsIntegral R S]`, the Krull dimension of $M$ as an $S$-module equals the Krull dimension of $M$ as an $R$-module: `ringKrullDim (S ⧸ Module.annihilator S M) = ringKrullDim (R ⧸ Module.annihilator R M)`. -/)
  (uses := [isIntegral_quotient_annihilator, ringKrullDim_eq_of_isIntegral, annihilatorQuotientAlgebra_injective])
  (hasProof := true)
  (proof := /-- Let `inst := annihilatorQuotientAlgebra R S M` be the induced algebra structure on $S/\operatorname{Ann}_S(M)$ over $R/\operatorname{Ann}_R(M)$. By `isIntegral_quotient_annihilator` this extension is integral, and by `annihilatorQuotientAlgebra_injective` its algebra map is injective; applying `ringKrullDim_eq_of_isIntegral` (with `inst` as the `Algebra` instance and the injectivity of its algebra map) yields `ringKrullDim (R ⧸ Module.annihilator R M) = ringKrullDim (S ⧸ Module.annihilator S M)`, and symmetrizing gives the claimed equality. -/)
  (proofUses := [annihilatorQuotientAlgebra, isIntegral_quotient_annihilator, ringKrullDim_eq_of_isIntegral, annihilatorQuotientAlgebra_injective])
  (title := /-- Krull dimension of a module is invariant under integral base change -/)
]
theorem ringKrullDim_quot_annihilator_eq {R S M : Type} [CommRing R] [CommRing S] [AddCommGroup M]
    [Algebra R S] [Module S M] [Module R M] [IsScalarTower R S M] [Algebra.IsIntegral R S] :
    ringKrullDim (S ⧸ (Module.annihilator S M)) = ringKrullDim (R ⧸ (Module.annihilator R M)) := by
  letI := annihilatorQuotientAlgebra R S M
  have h_alg := isIntegral_quotient_annihilator (R := R) (S := S) (M := M)
  letI : Algebra.IsIntegral (R ⧸ Module.annihilator R M) (S ⧸ Module.annihilator S M) := h_alg
  have h_inj : Function.Injective (algebraMap (R ⧸ Module.annihilator R M)
      (S ⧸ Module.annihilator S M)) :=
    annihilatorQuotientAlgebra_injective (R := R) (S := S) (M := M)
  exact (ringKrullDim_eq_of_isIntegral (A := R ⧸ Module.annihilator R M)
    (B := S ⧸ Module.annihilator S M) h_inj).symm
