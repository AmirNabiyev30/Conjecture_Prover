import Mathlib
import Architect

/-!
# Krull dimension of a module is invariant under integral scalar extension

We prove that if `S` is integral over `R` (via `[Algebra R S] [Algebra.IsIntegral R S]`) and `M`
is an `S`-module viewed as an `R`-module through the tower `[IsScalarTower R S M]`, then
`ringKrullDim (S ⧸ Module.annihilator S M) = ringKrullDim (R ⧸ Module.annihilator R M)`,
i.e. the Krull dimension of `M` computed over `S` equals the Krull dimension of `M` computed
over `R`.

Proof structure:

1. `annihilator_comap` — the `R`-annihilator of `M` is the contraction to `R` of the
   `S`-annihilator of `M` (a scalar-tower fact).
2. `quotientAnnihilator_isIntegral` — the induced algebra map
   `R / comap Ann_S(M) → S / Ann_S(M)` is integral (`Algebra.IsIntegral.quotient`).
3. `quotientAnnihilator_ker_eq_bot` — the kernel of the induced algebra map is trivial:
   the kernel of `mk Ann_S(M) ∘ algebraMap` is the contraction `comap Ann_S(M)`
   (`Ideal.injective_lift_iff`, `RingHom.comap_ker`, `Ideal.mk_ker`).
4. `quotientAnnihilator_injective` — the induced algebra map is injective, since its kernel is
   trivial by (3) (`RingHom.injective_iff_ker_eq_bot`).
5. `ringKrullDim_eq_of_injective_integral_algebra` — Cohen–Seidenberg: an injective integral
   extension of commutative rings preserves Krull dimension (going-up + incomparability).
6. `ringKrullDim_quot_annihilator_eq` — the main theorem, obtained by rewriting
   `Module.annihilator R M` via `annihilator_comap` and applying (5) to the quotient
   extension from (2) and (4).
-/

/-- The `R`-annihilator of an `S`-module `M` (viewed as an `R`-module by restriction of scalars)
is exactly the contraction of its `S`-annihilator along `R → S`:
$\operatorname{Ann}_R(M) = \operatorname{comap}(\operatorname{Ann}_S(M))$. -/
@[blueprint
  (statement := /-- For an $S$-module $M$ viewed as an $R$-module via restriction of scalars along
    the algebra map $R \to S$, the $R$-annihilator of $M$ is the contraction of its $S$-annihilator:
    $\operatorname{Ann}_R(M) = \operatorname{Ann}_S(M) \cap R =
    \mathrm{comap}_{R \to S}(\operatorname{Ann}_S(M))$. -/)
  (hasProof := true)
  (proof := /-- For $r \in R$ we have $r \in \operatorname{Ann}_R(M)$ iff $r \cdot m = 0$ for all
    $m \in M$ (`Module.mem_annihilator`). By the tower law
    $r \cdot m = (\mathrm{algebraMap}\ r) \cdot m$ (`IsScalarTower`), this is equivalent to
    $(\mathrm{algebraMap}\ r) \cdot m = 0$ for all $m$, i.e.
    $\mathrm{algebraMap}\ r \in \operatorname{Ann}_S(M)$, i.e.
    $r \in \mathrm{comap}(\mathrm{algebraMap}\ R\ S)(\operatorname{Ann}_S(M))$.
    Conclude by extensionality of ideals. -/)
  (proofUses := [])]
lemma annihilator_comap {R S M : Type} [CommRing R] [CommRing S] [AddCommGroup M] [Algebra R S]
    [Module S M] [Module R M] [IsScalarTower R S M] :
    Module.annihilator R M = Ideal.comap (algebraMap R S) (Module.annihilator S M) := by
  ext r
  constructor
  · intro hr
    rw [Ideal.mem_comap]
    rw [Module.mem_annihilator] at hr ⊢
    intro m
    rw [IsScalarTower.algebraMap_smul (R := R) S r m]
    exact hr m
  · intro hr
    rw [Ideal.mem_comap] at hr
    rw [Module.mem_annihilator] at hr ⊢
    intro m
    rw [← IsScalarTower.algebraMap_smul (R := R) S r m]
    exact hr m

/-- Quotienting the integral extension `R → S` by the annihilator of `M` yields an integral
extension `R / comap Ann_S(M) → S / Ann_S(M)`. -/
@[blueprint
  (statement := /-- Since $S$ is integral over $R$, the induced algebra map on quotients
    $R / \mathrm{comap}_{R \to S}(\operatorname{Ann}_S(M)) \to S / \operatorname{Ann}_S(M)$
    is integral, i.e. $\mathrm{Algebra.IsIntegral}$
    $(R \setminus \mathrm{comap}(\operatorname{Ann}_S(M)))\ (S \setminus \operatorname{Ann}_S(M))$. -/)
  (hasProof := true)
  (proof := /-- Apply the Mathlib instance `Algebra.IsIntegral.quotient` to
    `[Algebra.IsIntegral R S]` with $I = \operatorname{Ann}_S(M)$; its conclusion is exactly the
    claimed integrality of the quotient algebra map. -/)
  (proofUses := [Algebra.IsIntegral.quotient])]
lemma quotientAnnihilator_isIntegral {R S M : Type} [CommRing R] [CommRing S] [AddCommGroup M] [Algebra R S]
    [Module S M] [Module R M] [IsScalarTower R S M] [Algebra.IsIntegral R S] :
    Algebra.IsIntegral (R ⧸ Ideal.comap (algebraMap R S) (Module.annihilator S M))
      (S ⧸ Module.annihilator S M) := by
  exact Algebra.IsIntegral.quotient (I := Module.annihilator S M)

/-- The kernel of the induced algebra map `R / comap Ann_S(M) → S / Ann_S(M)` is trivial:
a class `[r]` maps to zero iff `algebraMap r ∈ Ann_S(M)`, which by definition of the
contraction is exactly `r ∈ comap Ann_S(M)`. -/
@[blueprint
  (statement := /-- The kernel of the induced algebra map
    $R / \mathrm{comap}_{R \to S}(\operatorname{Ann}_S(M)) \to S / \operatorname{Ann}_S(M)$
    is trivial. -/)
  (hasProof := true)
  (proof := /-- The algebra map on quotients is (definitionally) the lift
    `Ideal.Quotient.lift I ((Ideal.Quotient.mk (Ann_S(M))).comp (algebraMap R S)) H` with
    `I = comap (algebraMap R S) (Ann_S(M))` and `H : ∀ r ∈ I, mk (Ann_S(M)) (algebraMap r) = 0`,
    because the algebra structure on $S / \operatorname{Ann}_S(M)$ is induced by this composite.
    By `Ideal.injective_lift_iff` this lift is injective iff the kernel of the composite is `I`;
    the composite's kernel is `comap (algebraMap R S) (ker (mk Ann_S(M)))`
    (`RingHom.comap_ker`), which equals `I` by `Ideal.mk_ker`. Conclude with
    `RingHom.injective_iff_ker_eq_bot`. -/)
  (proofUses := [Ideal.injective_lift_iff, RingHom.comap_ker, Ideal.mk_ker,
    RingHom.injective_iff_ker_eq_bot])]
lemma quotientAnnihilator_ker_eq_bot {R S M : Type} [CommRing R] [CommRing S] [AddCommGroup M] [Algebra R S]
    [Module S M] [Module R M] [IsScalarTower R S M] :
    RingHom.ker (algebraMap (R ⧸ Ideal.comap (algebraMap R S) (Module.annihilator S M))
      (S ⧸ Module.annihilator S M)) = ⊥ := by
  rw [← RingHom.injective_iff_ker_eq_bot]
  apply (Ideal.injective_lift_iff (I := Ideal.comap (algebraMap R S) (Module.annihilator S M))
    (f := (Ideal.Quotient.mk (Module.annihilator S M)).comp (algebraMap R S)) (by
      intro x hx
      exact (Ideal.Quotient.eq_zero_iff_mem).2 hx)).2
  rw [← RingHom.comap_ker, Ideal.mk_ker]

/-- The induced algebra map `R / comap Ann_S(M) → S / Ann_S(M)` is injective. -/
@[blueprint
  (statement := /-- The canonical algebra map
    $R / \mathrm{comap}_{R \to S}(\operatorname{Ann}_S(M)) \to S / \operatorname{Ann}_S(M)$
    is injective. -/)
  (hasProof := true)
  (proof := /-- By `quotientAnnihilator_ker_eq_bot` the kernel of the induced algebra map is
    trivial; apply `RingHom.injective_iff_ker_eq_bot`. -/)
  (proofUses := [quotientAnnihilator_ker_eq_bot, RingHom.injective_iff_ker_eq_bot])]
lemma quotientAnnihilator_injective {R S M : Type} [CommRing R] [CommRing S] [AddCommGroup M] [Algebra R S]
    [Module S M] [Module R M] [IsScalarTower R S M] :
    Function.Injective (algebraMap (R ⧸ Ideal.comap (algebraMap R S) (Module.annihilator S M))
      (S ⧸ Module.annihilator S M)) := by
  rw [RingHom.injective_iff_ker_eq_bot]
  exact quotientAnnihilator_ker_eq_bot

/-- Cohen–Seidenberg: an injective integral extension of commutative rings preserves Krull
dimension: $\dim B = \dim A$ whenever $A \hookrightarrow B$ is integral. -/
@[blueprint
  (statement := /-- (Cohen–Seidenberg) Let $A \to B$ be an injective integral extension of
    commutative rings. Then the Krull dimensions agree:
    $\dim B = \dim A$, i.e. $\mathrm{ringKrullDim}\ B = \mathrm{ringKrullDim}\ A$. -/)
  (hasProof := true)
  (proof := /-- Going-up (`Ideal.exists_ideal_over_prime_of_isIntegral`), with injectivity ensuring
    that the kernel is zero and hence every prime of $A$ contains it, lifts every chain of primes
    of $A$ to a chain of primes of $B$; this gives $\dim A \le \dim B$.
    Incomparability (`Ideal.IntegralClosure.comap_lt_comap`) makes
    $\mathrm{comap} : \mathrm{Spec}(B) \to \mathrm{Spec}(A)$ strictly monotone, so chains of primes
    of $B$ contract to chains of primes of $A$; together with
    `Order.krullDim_le_of_strictMono` and the definition
    $\mathrm{ringKrullDim}\ R = \mathrm{Order.krullDim}\ (\mathrm{PrimeSpectrum}\ R)$, this gives
    $\dim B \le \dim A$. Combine the two inequalities. -/)
  (proofUses := [Ideal.IntegralClosure.comap_lt_comap, Ideal.exists_ideal_over_prime_of_isIntegral,
    Order.krullDim_le_of_strictMono])]
lemma ringKrullDim_eq_of_injective_integral_algebra {A B : Type} [CommRing A] [CommRing B] [Algebra A B]
    (hAB_inj : Function.Injective (algebraMap A B)) [Algebra.IsIntegral A B] :
    ringKrullDim B = ringKrullDim A := by
  -- dim B ≤ dim A via incomparability: comap is strictly monotone
  have hmono : StrictMono (PrimeSpectrum.comap (algebraMap A B)) := by
    intro p q hpq
    rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
    rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal]
    exact Ideal.IsIntegral.comap_lt_comap (I := p.asIdeal) (J := q.asIdeal)
      ((PrimeSpectrum.asIdeal_lt_asIdeal p q).mpr hpq)
  have hdimBA : ringKrullDim B ≤ ringKrullDim A := by
    rw [ringKrullDim, ringKrullDim]
    exact Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap A B)) hmono
  -- dim A ≤ dim B via going-up: lift every chain of primes of A to one of B
  have hdimAB : ringKrullDim A ≤ ringKrullDim B := by
    rw [ringKrullDim, ringKrullDim]
    simp only [Order.krullDim]
    apply iSup_le
    intro l
    let P0 : Ideal A := (RelSeries.head l).asIdeal
    have hker_le : Ideal.comap (algebraMap A B) (⊥ : Ideal B) ≤ P0 := by
      rw [show Ideal.comap (algebraMap A B) (⊥ : Ideal B) = (⊥ : Ideal A) from
        (RingHom.injective_iff_ker_eq_bot (algebraMap A B)).mp hAB_inj]
      exact bot_le
    obtain ⟨Q0, _hQ0ge, hQ0prime, hQ0over⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral (R := A) (S := B) P0 (⊥ : Ideal B) hker_le
    haveI : Q0.IsPrime := hQ0prime
    haveI : Q0.LiesOver (RelSeries.head l).asIdeal :=
      Ideal.LiesOver.mk (by simpa [Ideal.under] using hQ0over.symm)
    obtain ⟨L, hLlen, _hLhead, _hLmap⟩ :=
      Ideal.exists_ltSeries_of_hasGoingUp (R := A) (S := B) l Q0
    rw [← hLlen]
    exact le_iSup (fun m : LTSeries (PrimeSpectrum B) => (m.length : WithBot ℕ∞)) L
  exact le_antisymm hdimBA hdimAB

/-- Suppose that a ring $S$ is integral over the image of a ring homomorphism $R \to S$. Show that
the Krull dimension of $M$ as an $S$-module is the same as the Krull dimension of $M$ as an
$R$-module. -/
@[blueprint
  (statement := /-- If $S$ is integral over $R$ (`Algebra.IsIntegral R S`) and $M$ is an
    $S$-module viewed as an $R$-module through the scalar tower `IsScalarTower R S M`, then
    the Krull dimension of $M$ as an $S$-module coincides with its Krull dimension as an
    $R$-module:
    $\mathrm{ringKrullDim}\ (S / \operatorname{Ann}_S(M)) = \mathrm{ringKrullDim}\ (R / \operatorname{Ann}_R(M))$. -/)
  (hasProof := true)
  (proof := /-- Rewrite $\operatorname{Ann}_R(M) = \mathrm{comap}(\operatorname{Ann}_S(M))$ by
    `annihilator_comap` inside $\dim(R / \operatorname{Ann}_R(M))$
    (via `congrArg`), so the goal becomes
    $\dim(S / \operatorname{Ann}_S(M)) = \dim(R / \mathrm{comap}(\operatorname{Ann}_S(M)))$.
    The quotient algebra map
    $R / \mathrm{comap}(\operatorname{Ann}_S(M)) \to S / \operatorname{Ann}_S(M)$ is integral by
    `quotientAnnihilator_isIntegral` and injective by `quotientAnnihilator_injective`; apply
    `ringKrullDim_eq_of_injective_integral_algebra` to conclude. -/)
  (proofUses := [annihilator_comap, quotientAnnihilator_isIntegral, quotientAnnihilator_injective,
    ringKrullDim_eq_of_injective_integral_algebra])]
theorem ringKrullDim_quot_annihilator_eq {R S M : Type} [CommRing R] [CommRing S] [AddCommGroup M] [Algebra R S]
    [Module S M] [Module R M] [IsScalarTower R S M] [Algebra.IsIntegral R S] :
    ringKrullDim (S ⧸ (Module.annihilator S M)) = ringKrullDim (R ⧸ (Module.annihilator R M)) := by
  rw [annihilator_comap (R := R) (S := S)]
  letI : Algebra.IsIntegral (R ⧸ Ideal.comap (algebraMap R S) (Module.annihilator S M))
      (S ⧸ Module.annihilator S M) := quotientAnnihilator_isIntegral
  exact ringKrullDim_eq_of_injective_integral_algebra quotientAnnihilator_injective
