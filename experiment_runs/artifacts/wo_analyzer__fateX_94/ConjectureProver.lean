@[blueprint
  (statement := /-- A subset $S \subseteq \mathbb{N}$ is a *finite union of non-degenerate arithmetic progressions up to a finite remainder* if there are a finite set $F$, a number $r \in \mathbb{N}$, pairs $(a_i, d_i)$ for $i < r$ with $0 < d_i$, such that $$S = F \cup \bigcup_{i < r} \{ a_i + d_i \cdot m : m \in \mathbb{N} \}.$$ -/)
  (title := /-- A set is a finite union of arithmetic progressions (up to a finite set) -/)]
def IsFiniteUnionOfAPs (S : Set ℕ) : Prop :=
  ∃ (F : Finset ℕ) (r : ℕ) (a : Fin r → ℕ) (d : Fin r → ℕ),
    (∀ i : Fin r, 0 < d i) ∧ S = (F : Set ℕ) ∪ {n : ℕ | ∃ i : Fin r, ∃ m : ℕ, n = a i + d i * m}

@[blueprint
  (statement := /-- Let $S \subseteq \mathbb{N}$ be a finite union of non-degenerate arithmetic progressions up to a finite remainder. Then $S$ is finite, or $S$ contains an arithmetic progression $\{ a + d \cdot n : n \in \mathbb{N} \}$ with positive common difference $d > 0$. -/)
  (proof := /-- Unpack the hypothesis as $S = F \cup \bigcup_{i<r} (a_i + d_i \cdot \mathbb{N})$ with each $d_i > 0$ and $F$ finite. If $r = 0$, then $S = F$ is finite. Otherwise pick $i_0 < r$; since every element of $a_{i_0} + d_{i_0} \cdot \mathbb{N}$ lies in the union, it lies in $S$, so $S$ contains the arithmetic progression of difference $d_{i_0} > 0$ starting at $a_{i_0}$. -/)
