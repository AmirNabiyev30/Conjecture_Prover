  calc
    ∫ x in Icc (0 : ℝ) 1, ∑ i ∈ Finset.range k, a i * (x ^ i * f x)
        = ∑ i ∈ Finset.range k, ∫ x in Icc (0 : ℝ) 1, a i * (x ^ i * f x) := by
          apply MeasureTheory.integral_finsetSum
          intro i hi
          have hcont_pow : ContinuousOn (fun x : ℝ => x ^ i) (Icc (0 : ℝ) 1) :=
            (continuous_pow i).continuousOn
          have hpow_f : IntegrableOn (fun x : ℝ => x ^ i * f x) (Icc (0 : ℝ) 1) :=
            MeasureTheory.IntegrableOn.continuousOn_mul hcont_pow hfintegrable isCompact_Icc
          exact MeasureTheory.Integrable.const_mul hpow_f (a i)
    _ = 0 := by
          simp_rw [MeasureTheory.integral_const_mul]
          apply Finset.sum_eq_zero
          intro i hi
          rw [hfint i (Finset.mem_range.mp hi)]
          simp

