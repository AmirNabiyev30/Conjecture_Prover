@[blueprint
  (statement := /-- The integral of the absolute value of the shifted power: $\int_0^1 |x-\tfrac12|^n\, dx = \frac{1}{2^n (n+1)} = \frac{1}{\operatorname{putnamBound}(n)}$. -/)
  (proof := /-- Set $k = n.\text{toNat}$ and rewrite the integer powers to natural powers (`Int.toNat_of_nonneg`, `zpow_natCast`), so the integrand becomes $|(x-\tfrac12)^k|$.  Convert the set integral over `Icc 0 1` to the interval integral $\int_0^1$ (`MeasureTheory.integral_Icc_eq_integral_Ioc` + `intervalIntegral.integral_of_le`), then use `integral_abs_shifted_pow_eq_two_mul` and `integral_x_pow_half` to obtain $2 \cdot (1/2)^{k+1}/(k+1)$.  Simplify this to $1/(2^k(k+1))$ by algebra (`ring_nf`/`field_simp`/`← mul_pow`) and rewrite the denominator as `putnamBound n` via `putnamBound` and `zpow_natCast`. -/)
  (uses := [shiftedPower, putnamBound])
  (proofUses := [integral_abs_shifted_pow_eq_two_mul, integral_x_pow_half])]
lemma integral_abs_center_pow (n : ℤ) (hn : n ≥ 0) :
    ∫ x in Icc (0 : ℝ) 1, |shiftedPower n x| = 1 / putnamBound n := by
  let k := n.toNat
  have hk : (k : ℤ) = n := by
    simpa [k] using (Int.toNat_of_nonneg hn).symm
  have hf : (fun x : ℝ => |shiftedPower n x|) = fun x => |(x - 1 / 2) ^ k| := by
    funext x
    simp [shiftedPower, ← hk, zpow_natCast]
  rw [hf]
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc]
  rw [← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  rw [integral_abs_shifted_pow_eq_two_mul k]
  rw [integral_x_pow_half k]
  have halg : 2 * ((1 / 2 : ℝ) ^ (k + 1) / (↑k + 1)) = 1 / (2 ^ k * (↑k + 1)) := by
    rw [pow_succ, div_pow, one_pow]
    field_simp
  rw [halg]
  have hput : putnamBound n = 2 ^ k * (↑k + 1) := by
    rw [putnamBound, ← hk, zpow_natCast]
    simp
  rw [hput]

@[blueprint
  (statement := /-- The centered power is non-zero almost everywhere on $[0,1]$: $0 < |p_n(x)|$ for almost every $x \in [0,1]$ (it vanishes only at $x = 1/2$). -/)
  (proof := /-- The zero set $\{x : |p_n(x)| = 0\}$ is contained in the singleton $\{1/2\}$ (for $n \ge 1$; empty for $n = 0$), which has volume zero (`Real.volume_singleton`); conclude with `ae_iff` and `ae_restrict_iff'`. -/)
  (uses := [shiftedPower])
  (proofUses := [])]
lemma abs_shiftedPower_pos_ae (n : ℤ) (hn : n ≥ 0) :
    ∀ᵐ x ∂(volume.restrict (Icc (0 : ℝ) 1)), 0 < |shiftedPower n x| := by
  rw [MeasureTheory.ae_restrict_iff' measurableSet_Icc]
  rw [MeasureTheory.ae_iff]
  refine MeasureTheory.measure_mono_null ?_ (Real.volume_singleton (a := (1 / 2 : ℝ)))
  intro x hx
  have hnotpos : ¬ 0 < |shiftedPower n x| := (Classical.not_imp.mp hx).2
  have habs : |shiftedPower n x| = 0 := le_antisymm (not_lt.mp hnotpos) (abs_nonneg _)
  have hzero : shiftedPower n x = 0 := abs_eq_zero.mp habs
  by_contra hne
  have hbase : x - (1 / 2 : ℝ) ≠ 0 := sub_ne_zero.mpr hne
  have hpow : (x - (1 / 2 : ℝ)) ^ n ≠ 0 := zpow_ne_zero n hbase
  exact hpow (by simpa [shiftedPower] using hzero)

@[blueprint
  (statement := /-- $|p_n|$ is integrable on $[0,1]$: `IntegrableOn (fun x => |shiftedPower n x|) (Icc 0 1)`. -/)
  (proof := /-- $x \mapsto |p_n(x)|$ is continuous on the compact interval $[0,1]$ (rewrite the integer power to a natural power via `Int.toNat_of_nonneg` + `zpow_natCast`, then `fun_prop`); apply `ContinuousOn.integrableOn_compact`. -/)
  (uses := [shiftedPower])
  (proofUses := [])]
lemma integrableOn_abs_shifted_pow (n : ℤ) (hn : n ≥ 0) :
    IntegrableOn (fun x : ℝ => |shiftedPower n x|) (Icc (0 : ℝ) 1) := by
  have hzpow : ∀ x : ℝ, (x - 1 / 2) ^ n = (x - 1 / 2) ^ n.toNat := by
    intro x
    calc
      (x - 1 / 2) ^ n = (x - 1 / 2) ^ (n.toNat : ℤ) := by
        congr 1
        exact (Int.toNat_of_nonneg hn).symm
      _ = (x - 1 / 2) ^ n.toNat := by
        rw [zpow_natCast]
  have hfun : (fun x : ℝ => |shiftedPower n x|) = fun x : ℝ => |(x - 1 / 2) ^ n.toNat| := by
    funext x
    change |(x - 1 / 2) ^ n| = |(x - 1 / 2) ^ n.toNat|
    rw [hzpow x]
  have hcont : ContinuousOn (fun x : ℝ => |shiftedPower n x|) (Icc (0 : ℝ) 1) := by
    rw [hfun]
    fun_prop
  exact ContinuousOn.integrableOn_compact isCompact_Icc hcont

@[blueprint
  (statement := /-- Multiplying $f$ by the continuous function $|p_n|$ preserves integrability on $[0,1]$: `IntegrableOn (fun x => |shiftedPower n x| * |f x|) (Icc 0 1)`. -/)
  (proof := /-- Apply `IntegrableOn.mul_continuousOn` to `hfintegrable` and the continuous function $x \mapsto |p_n(x)|$ on the compact interval $[0,1]$, then take norms and rewrite $\||p_n(x)|\, f(x)\| = |p_n(x)| |f(x)|$ via `abs_mul`. -/)
  (uses := [shiftedPower])
  (proofUses := [])]
lemma integrableOn_abs_shifted_pow_mul (f : ℝ → ℝ) (n : ℤ) (hn : n ≥ 0)
    (hfintegrable : IntegrableOn f (Icc (0 : ℝ) 1)) :
    IntegrableOn (fun x : ℝ => |shiftedPower n x| * |f x|) (Icc (0 : ℝ) 1) := by
  have hK : IsCompact (Icc (0 : ℝ) 1) := isCompact_Icc
  have hcont : ContinuousOn (fun x : ℝ => |shiftedPower n x|) (Icc (0 : ℝ) 1) := by
    have hnn : (n.toNat : ℤ) = n := Int.toNat_of_nonneg hn
    have hc : Continuous fun x : ℝ => (x - 1 / 2) ^ n.toNat := by fun_prop
    have hc' : Continuous fun x : ℝ => (x - 1 / 2) ^ n := by
      convert hc using 1
      ext x
      conv_lhs => rw [← hnn]
      rw [zpow_natCast]
    simpa [shiftedPower] using (hc'.abs).continuousOn
  have h1 : IntegrableOn (fun x => f x * |shiftedPower n x|) (Icc (0 : ℝ) 1) :=
    hfintegrable.mul_continuousOn hcont hK
  have h1n : IntegrableOn (fun x : ℝ => ‖f x * |shiftedPower n x|‖) (Icc (0 : ℝ) 1) := by
    simpa [IntegrableOn] using (Integrable.norm h1)
  simpa [Real.norm_eq_abs, abs_mul, abs_abs, mul_comm] using h1n

@[blueprint
  (statement := /-- If $|f(x)| < \operatorname{putnamBound}(n)$ for almost every $x \in [0,1]$, then $\int_0^1 |p_n(x)| |f(x)|\, dx < \operatorname{putnamBound}(n) \int_0^1 |p_n(x)|\, dx$. -/)
  (proof := /-- Let $p_n(x) = (x-\tfrac12)^n$ and $c = \operatorname{putnamBound}(n)$.  Transfer `hbound` and `abs_shiftedPower_pos_ae` from `Icc 0 1` to `Ioc 0 1` via `ae_restrict_iff'`; pointwise a.e. on `Ioc 0 1$ we get $|p_n(x)| > 0$ and $|f(x)| < c$, hence a.e. $|p_n||f| \le |p_n| c$ (`mul_le_mul_of_nonneg_left`) and $|p_n||f| < |p_n| c$ (`mul_lt_mul_of_pos_left`); the latter yields $\nu\{x : |p_n||f| < |p_n| c\} = \nu\,\text{univ} = \operatorname{volume}(\operatorname{Ioc}\,0\,1) \ne 0$.  Integrability of both sides on `Icc 0 1` comes from `integrableOn_abs_shifted_pow_mul` and `integrableOn_abs_shifted_pow` (times the constant $c$).  Convert to interval integrals, apply `intervalIntegral.integral_lt_integral_of_ae_le_of_measure_setOf_lt_ne_zero`, and convert back, using `integral_mul_const` for $\int |p_n|\, c = c \int |p_n|$. -/)
  (uses := [shiftedPower, putnamBound])
  (proofUses := [abs_shiftedPower_pos_ae, integrableOn_abs_shifted_pow,
    integrableOn_abs_shifted_pow_mul])]
lemma bound_center_pow_ae
    (f : ℝ → ℝ) (n : ℤ) (hn : n ≥ 0)
    (hfintegrable : IntegrableOn f (Icc (0 : ℝ) 1))
    (hbound : ∀ᵐ x ∂(volume.restrict (Icc (0 : ℝ) 1)), |f x| < putnamBound n) :
    ∫ x in Icc (0 : ℝ) 1, |shiftedPower n x| * |f x| <
      putnamBound n * ∫ x in Icc (0 : ℝ) 1, |shiftedPower n x| := by
  have hmono : volume.restrict (Set.Ioc (0 : ℝ) 1) ≤ volume.restrict (Icc (0 : ℝ) 1) := by
    exact MeasureTheory.Measure.restrict_mono Set.Ioc_subset_Icc_self le_rfl
  have hbound' : ∀ᵐ x ∂(volume.restrict (Set.Ioc (0 : ℝ) 1)), |f x| < putnamBound n :=
    MeasureTheory.ae_mono hmono hbound
  have hpos' : ∀ᵐ x ∂(volume.restrict (Set.Ioc (0 : ℝ) 1)), 0 < |shiftedPower n x| :=
    MeasureTheory.ae_mono hmono (abs_shiftedPower_pos_ae n hn)
  have hlt_ae : ∀ᵐ x ∂(volume.restrict (Set.Ioc (0 : ℝ) 1)),
      |shiftedPower n x| * |f x| < |shiftedPower n x| * putnamBound n := by
    filter_upwards [hbound', hpos'] with x hfx hpx
    exact mul_lt_mul_of_pos_left hfx hpx
  have hle_ae : (fun x => |shiftedPower n x| * |f x|) ≤ᵐ[volume.restrict (Set.Ioc (0 : ℝ) 1)]
      (fun x => |shiftedPower n x| * putnamBound n) := by
    filter_upwards [hlt_ae] with x hx
    exact le_of_lt hx
  have hset_ae : {x | |shiftedPower n x| * |f x| < |shiftedPower n x| * putnamBound n} =ᵐ[volume.restrict (Set.Ioc (0 : ℝ) 1)] Set.univ := by
    filter_upwards [hlt_ae] with x hx
    exact propext ⟨fun _ => trivial, fun _ => hx⟩
  have hlt_meas : (volume.restrict (Set.Ioc (0 : ℝ) 1))
      {x | |shiftedPower n x| * |f x| < |shiftedPower n x| * putnamBound n} ≠ 0 := by
    rw [MeasureTheory.measure_congr hset_ae]
    rw [MeasureTheory.Measure.restrict_apply' measurableSet_Ioc]
    simp
  have hImul : IntervalIntegrable (fun x => |shiftedPower n x| * |f x|) volume (0 : ℝ) 1 := by
    constructor
    · exact (integrableOn_abs_shifted_pow_mul f n hn hfintegrable).mono_set Set.Ioc_subset_Icc_self
    · simp
  have hIabs : IntervalIntegrable (fun x => |shiftedPower n x|) volume (0 : ℝ) 1 := by
    constructor
    · exact (integrableOn_abs_shifted_pow n hn).mono_set Set.Ioc_subset_Icc_self
    · simp
  have hIg : IntervalIntegrable (fun x => |shiftedPower n x| * putnamBound n) volume (0 : ℝ) 1 :=
    hIabs.mul_const (putnamBound n)
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc]
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc]
  rw [← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  rw [← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  have hconst : putnamBound n * ∫ x in (0 : ℝ)..1, |shiftedPower n x| =
      ∫ x in (0 : ℝ)..1, |shiftedPower n x| * putnamBound n := by
    rw [mul_comm, ← intervalIntegral.integral_mul_const (putnamBound n) (fun x => |shiftedPower n x|)]
  rw [hconst]
  exact intervalIntegral.integral_lt_integral_of_ae_le_of_measure_setOfPred_lt_ne_zero
    (by norm_num : (0 : ℝ) ≤ 1) hImul hIg hle_ae hlt_meas

@[blueprint
  (statement := /-- Under the moment hypotheses, $|f(x)| < \operatorname{putnamBound}(n)$ almost everywhere on $[0,1]$ is impossible. -/)
  (proof := /-- Chain of inequalities: by `center_pow_moment` we have $\int p_n f = 1$, hence $1 = |\int p_n f|$; by `abs_center_pow_integral$ this is $\le \int |p_n||f|$; by `bound_center_pow_ae` this is $< c \int |p_n|$ with $c = \operatorname{putnamBound}(n)$; by `integral_abs_center_pow$ we have $\int |p_n| = 1/c$, so $c \int |p_n| = 1$ using `putnamBound_pos` (so $c \ne 0$ and $c \cdot c^{-1} = 1$).  The resulting $1 \le \int |p_n||f| < 1$ contradicts trichotomy. -/)
  (uses := [shiftedPower, putnamBound])
  (proofUses := [putnamBound_pos, center_pow_moment, abs_center_pow_integral,
    bound_center_pow_ae, integral_abs_center_pow])]
lemma contradiction_ae
    (f : ℝ → ℝ) (n : ℤ) (hn : n ≥ 0)
    (hfintegrable : IntegrableOn f (Icc (0 : ℝ) 1))
    (hfint : ∀ i ∈ Icc 0 (n - 1), ∫ x in Icc (0 : ℝ) 1, x ^ i * f x = 0)
    (hfintlast : ∫ x in Icc (0 : ℝ) 1, x ^ n * f x = 1)
    (hbound : ∀ᵐ x ∂(volume.restrict (Icc (0 : ℝ) 1)), |f x| < putnamBound n) : False := by
  have hmom : ∫ x in Icc (0 : ℝ) 1, shiftedPower n x * f x = 1 :=
    center_pow_moment f n hn hfintegrable hfint hfintlast
  have habs : |∫ x in Icc (0 : ℝ) 1, shiftedPower n x * f x| ≤
      ∫ x in Icc (0 : ℝ) 1, |shiftedPower n x| * |f x| :=
    abs_center_pow_integral f n
  have h1 : (1 : ℝ) ≤ ∫ x in Icc (0 : ℝ) 1, |shiftedPower n x| * |f x| := by
    rw [hmom] at habs
    simpa using habs
  have hlt : ∫ x in Icc (0 : ℝ) 1, |shiftedPower n x| * |f x| <
      putnamBound n * ∫ x in Icc (0 : ℝ) 1, |shiftedPower n x| :=
    bound_center_pow_ae f n hn hfintegrable hbound
  have hcpos : 0 < putnamBound n := putnamBound_pos n hn
  have hc : putnamBound n * (1 / putnamBound n) = 1 := by
    field_simp [hcpos.ne']
  have h2 : putnamBound n * ∫ x in Icc (0 : ℝ) 1, |shiftedPower n x| = 1 := by
    rw [integral_abs_center_pow n hn, hc]
  rw [h2] at hlt
  linarith

@[blueprint
  (statement := /-- If there is no measurable subset $S \subseteq [0,1]$ of positive volume on which $|f(x)| \ge \operatorname{putnamBound}(n)$, then $|f(x)| < \operatorname{putnamBound}(n)$ for almost every $x \in [0,1]$. -/)
  (proof := /-- Contrapositive: if the (a.e.-measurable) set $B = \{x \in [0,1] : c \le |f(x)|\}$ had positive volume, then since $f$ is integrable there is a measurable $g$ with $f = g$ a.e.; the measurable set $A = \{x \in [0,1] : c \le |g(x)|\}$ satisfies $A \triangle B$ null, so for a measurable null set $N \supseteq A \triangle B$ the set $S = A \setminus N$ is measurable, $S \subseteq B$, and $\operatorname{volume} S = \operatorname{volume} A > 0$, witnessing a good set — contradiction.  (Null set facts via `MeasureTheory.nullMeasurableSet`/`exists_measurable_superset_ae_eq`; a.e. reasoning via `MeasureTheory.ae_iff`.) -/)
  (uses := [putnamBound])
  (proofUses := [])]
lemma ae_small_of_no_good_set
    (f : ℝ → ℝ) (n : ℤ)
    (hfintegrable : IntegrableOn f (Icc (0 : ℝ) 1))
    (h : ¬ ∃ S, S ⊆ Icc (0 : ℝ) 1 ∧ MeasurableSet S ∧ volume S > 0 ∧
      ∀ x ∈ S, putnamBound n ≤ |f x|) :
    ∀ᵐ x ∂(volume.restrict (Icc (0 : ℝ) 1)), |f x| < putnamBound n := by
  classical
  set μ : Measure ℝ := volume.restrict (Icc (0 : ℝ) 1) with hμdef
  set c : ℝ := putnamBound n with hcdef
  by_contra hQ
  -- (1) The set B = {x | c ≤ |f x|} has positive μ-measure
  have hBpos : 0 < μ {x | c ≤ |f x|} := by
    rw [ae_iff] at hQ
    have hset : {x | c ≤ |f x|} = {x | ¬ |f x| < c} := by
      ext x
      exact (not_lt (a := |f x|) (b := c)).symm
    rw [hset]
    exact pos_iff_ne_zero.mpr hQ
  -- (2) f is a.e.-measurable, so pick measurable g with f = g a.e.
  have hfae : AEMeasurable f μ := by
    exact (aestronglyMeasurable_iff_aemeasurable).mp
      (by simpa [hμdef] using hfintegrable.aestronglyMeasurable)
  rcases hfae with ⟨g, hg_meas, hfg⟩
  have habs : ∀ᵐ x ∂μ, |f x| = |g x| := hfg.fun_comp abs
  set A : Set ℝ := {x | c ≤ |g x|} with hAdef
  set B : Set ℝ := {x | c ≤ |f x|} with hBdef
  -- (3) A \ B and B \ A are null (contained in {|f| ≠ |g|})
  have hdiff_null : μ {x | |f x| ≠ |g x|} = 0 := by
    simpa [ne_eq] using (ae_iff.mp habs)
  have hAB_sub : A \ B ⊆ {x | |f x| ≠ |g x|} := by
    intro x hx
    change c ≤ |g x| ∧ ¬ c ≤ |f x| at hx
    rcases hx with ⟨hxA, hxB⟩
    intro hEq
    apply hxB
    rwa [← hEq] at hxA
  have hAB : μ (A \ B) = 0 := measure_mono_null hAB_sub hdiff_null
  have hBA_sub : B \ A ⊆ {x | |f x| ≠ |g x|} := by
    intro x hx
    change c ≤ |f x| ∧ ¬ c ≤ |g x| at hx
    rcases hx with ⟨hxB, hxA⟩
    intro hEq
    apply hxA
    rwa [hEq] at hxB
  have hBA : μ (B \ A) = 0 := measure_mono_null hBA_sub hdiff_null
  -- (4) hence μ A = μ B > 0
  have hApos : 0 < μ A := by
    rw [measure_congr (ae_eq_set.mpr ⟨hAB, hBA⟩)]
    exact hBpos
  -- (5) A is measurable
  have hAmeas : MeasurableSet A := by
    rw [hAdef]
    exact measurableSet_Ici.preimage hg_meas.abs
  -- (6) take measurable null N ⊇ A \ B
  rcases exists_measurable_superset_of_null hAB with ⟨N, hABN, hNmeas, hNnull⟩
  -- (7) S := (A \ N) ∩ Icc 0 1
  set S : Set ℝ := (A \ N) ∩ Icc (0 : ℝ) 1 with hSdef
  have hSmeas : MeasurableSet S := by
    rw [hSdef]
    exact (hAmeas.diff hNmeas).inter measurableSet_Icc
  have hSsubIcc : S ⊆ Icc (0 : ℝ) 1 := by
    rw [hSdef]
    exact Set.inter_subset_right
  have hSsubB : S ⊆ B := by
    intro x hx
    have hxAN : x ∈ A \ N := hx.1
    have hxA : x ∈ A := hxAN.1
    have hxN : x ∉ N := hxAN.2
    by_contra hxB
    exact hxN (hABN ⟨hxA, hxB⟩)
  -- (8) μ (A \ N) = μ A
  have hAN : μ (A \ N) = μ A := by
    apply le_antisymm
    · exact measure_mono Set.sdiff_subset
    · calc
        μ A ≤ μ ((A \ N) ∪ N) := measure_mono (by
          intro x hx
          by_cases hxN : x ∈ N <;> simp [hxN, hx])
        _ ≤ μ (A \ N) + μ N := measure_union_le _ _
        _ = μ (A \ N) := by simp [hNnull]
  -- (9) volume S = μ (A \ N)
  have hSvol_eq : volume S = μ (A \ N) := by
    rw [hμdef]
    rw [Measure.restrict_apply (hAmeas.diff hNmeas)]
  -- (10) volume S > 0
  have hSvol : volume S > 0 := by
    rw [hSvol_eq]
    rw [hAN]
    exact hApos
  -- (11) good set
  have hSgood : ∀ x ∈ S, c ≤ |f x| := by
    intro x hx
    simpa [hBdef] using hSsubB hx
  exact h ⟨S, hSsubIcc, hSmeas, hSvol, hSgood⟩

/--
Let $f$ be an integrable function in $0 \leq x \leq 1$ and suppose for all $0 \leq i \leq n-1, \int_0^1 x^i f(x) dx = 0$. Further suppose that $\int_0^1 x^n f(x) dx = 1$. Show that $|f(x)| \geq 2^n(n+1)$ on a set of positive measure.
-/
@[blueprint
  (statement := /-- $\exists S \subseteq [0,1]$, $S$ measurable, $\operatorname{volume} S > 0$, with $|f(x)| \ge 2^n (n+1)$ for all $x \in S$. -/)
  (proof := /-- By contradiction: assume no such set exists.  Then `ae_small_of_no_good_set` yields $|f| < 2^n(n+1)$ almost everywhere on $[0,1]$, and `contradiction_ae` derives `False` from the moment hypotheses; hence a good set exists. -/)
  (uses := [putnamBound])
  (proofUses := [ae_small_of_no_good_set, contradiction_ae])]
theorem putnam_1972_a6
(f : ℝ → ℝ)
(n : ℤ)
(hn : n ≥ 0)
(hfintegrable: IntegrableOn f (Icc 0 1))
(hfint : ∀ i ∈ Icc 0 (n-1), ∫ x in Icc 0 1, x^i*(f x) = 0)
(hfintlast : ∫ x in Icc 0 1, x^n*(f x) = 1)
: ∃ S, S ⊆ Icc (0 : ℝ) 1 ∧ MeasurableSet S ∧ volume S > 0 ∧ ∀ x ∈ S, |f x| ≥ 2^n * (n + 1) := by
  by_contra h
  exact contradiction_ae f n hn hfintegrable hfint hfintlast (ae_small_of_no_good_set f n hfintegrable h)
