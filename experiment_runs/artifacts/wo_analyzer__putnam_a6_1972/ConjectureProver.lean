lemma center_pow_sub_moment_eq_zero
    (f : ℝ → ℝ) (n : ℤ) (hn : n ≥ 0)
    (hfintegrable : IntegrableOn f (Icc (0 : ℝ) 1))
    (hfint : ∀ i ∈ Icc 0 (n - 1), ∫ x in Icc (0 : ℝ) 1, x ^ i * f x = 0) :
    ∫ x in Icc (0 : ℝ) 1, (shiftedPower n x - x ^ n) * f x = 0 := by
