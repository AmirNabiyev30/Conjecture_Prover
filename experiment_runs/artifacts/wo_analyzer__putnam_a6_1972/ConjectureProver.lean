  have hnz : (k : ℤ) = n := by
    dsimp [k]
    exact Int.toNat_of_nonneg hn
  have hnz' : (n.toNat : ℤ) = n := by
    simpa [k] using hnz
  have hsum_eq : ∀ x, (x - 1 / 2) ^ k - x ^ k =
      ∑ i ∈ Finset.range k, ((k.choose i : ℝ) * (-(1 / 2)) ^ (k - i)) * x ^ i := by
    intro x
    simpa using sub_pow_half_eq_sum k x
  have hpoint : (fun x : ℝ => (shiftedPower n x - x ^ n) * f x) =
      (fun x : ℝ => (∑ i ∈ Finset.range k, ((k.choose i : ℝ) * (-(1 / 2)) ^ (k - i)) * x ^ i) * f x) := by
    funext x
    rw [show shiftedPower n x - x ^ n = ∑ i ∈ Finset.range k, ((k.choose i : ℝ) * (-(1 / 2)) ^ (k - i)) * x ^ i by
      unfold shiftedPower
      rw [← hnz]
      rw [zpow_natCast, zpow_natCast]
      exact hsum_eq x]
  rw [hpoint]
  exact integral_sum_mul_zero f k (fun i => (k.choose i : ℝ) * (-(1 / 2)) ^ (k - i)) hfintegrable (by
    intro i hi
    have hi_le : (i : ℤ) ≤ n - 1 := by
      have h1 : (i : ℤ) < n := by
        rw [← hnz']
        exact_mod_cast hi
      omega
    have hmem : (i : ℤ) ∈ Icc (0 : ℤ) (n - 1) := by
      constructor
      · exact_mod_cast Nat.zero_le i
      · exact hi_le
    simpa [zpow_natCast] using hfint (i : ℤ) hmem)

@[blueprint
  (statement := /-- The first nontrivial moment of the shifted polynomial: $\int_0^1 (x-\tfrac12)^n f(x)\, dx = 1$. -/)
  (proof := /-- Decompose $(x-\tfrac12)^n f = x^n f + ((x-\tfrac12)^n - x^n) f$, integrate and use additivity of the integral together with `hfintlast` (giving $\int x^n f = 1$) and `center_pow_sub_moment_eq_zero` (giving $\int ((x-\tfrac12)^n - x^n) f = 0$). -/)
  (uses := [shiftedPower])
  (proofUses := [center_pow_sub_moment_eq_zero])]
lemma center_pow_moment
    (f : ℝ → ℝ) (n : ℤ) (hn : n ≥ 0)
    (hfintegrable : IntegrableOn f (Icc (0 : ℝ) 1))
    (hfint : ∀ i ∈ Icc 0 (n - 1), ∫ x in Icc (0 : ℝ) 1, x ^ i * f x = 0)
    (hfintlast : ∫ x in Icc (0 : ℝ) 1, x ^ n * f x = 1) :
    ∫ x in Icc (0 : ℝ) 1, shiftedPower n x * f x = 1 := by
  have hn' : (n.toNat : ℤ) = n := Int.toNat_of_nonneg hn
  have hcont_xn : ContinuousOn (fun x : ℝ => x ^ n) (Icc (0 : ℝ) 1) := by
    have hc : ContinuousOn (fun x : ℝ => x ^ n.toNat) (Icc (0 : ℝ) 1) := by fun_prop
    refine hc.congr ?_
    intro x hx
    calc
      x ^ n = x ^ (n.toNat : ℤ) := by rw [hn']
      _ = x ^ n.toNat := zpow_natCast x n.toNat
  have hcont_shift : ContinuousOn (fun x : ℝ => shiftedPower n x) (Icc (0 : ℝ) 1) := by
    have hc : ContinuousOn (fun x : ℝ => (x - 1 / 2) ^ n.toNat) (Icc (0 : ℝ) 1) := by fun_prop
    refine hc.congr ?_
    intro x hx
    dsimp [shiftedPower]
    calc
      (x - 1 / 2) ^ n = (x - 1 / 2) ^ (n.toNat : ℤ) := by rw [hn']
      _ = (x - 1 / 2) ^ n.toNat := zpow_natCast (x - 1 / 2) n.toNat
  have hcont_diff : ContinuousOn (fun x : ℝ => shiftedPower n x - x ^ n) (Icc (0 : ℝ) 1) :=
    hcont_shift.sub hcont_xn
  have hK : IsCompact (Icc (0 : ℝ) 1) := isCompact_Icc
  have h1 : IntegrableOn (fun x : ℝ => x ^ n * f x) (Icc (0 : ℝ) 1) := by
    have h := IntegrableOn.mul_continuousOn hfintegrable hcont_xn hK
    simpa [mul_comm] using h
  have h2 : IntegrableOn (fun x : ℝ => (shiftedPower n x - x ^ n) * f x) (Icc (0 : ℝ) 1) := by
    have h := IntegrableOn.mul_continuousOn hfintegrable hcont_diff hK
    simpa [mul_comm] using h
  have hdecomp : (fun x : ℝ => shiftedPower n x * f x) = fun x : ℝ => x ^ n * f x + (shiftedPower n x - x ^ n) * f x := by
    funext x
    rw [← add_mul]
    ring
  calc
    ∫ x in Icc (0 : ℝ) 1, shiftedPower n x * f x
        = ∫ x in Icc (0 : ℝ) 1, (x ^ n * f x + (shiftedPower n x - x ^ n) * f x) := by
            rw [hdecomp]
    _ = (∫ x in Icc (0 : ℝ) 1, x ^ n * f x) + ∫ x in Icc (0 : ℝ) 1, (shiftedPower n x - x ^ n) * f x := by
            rw [integral_add h1 h2]
    _ = 1 + 0 := by
            rw [hfintlast, center_pow_sub_moment_eq_zero f n hn hfintegrable hfint]
    _ = 1 := by norm_num

