@[blueprint
  (statement := /-- By symmetry about $x = 1/2$, $\int_0^1 |x - \tfrac12|^k\, dx = 2\int_0^{1/2} x^k\, dx$. -/)
  (proof := /-- Split the interval integral at $1/2$ with `intervalIntegral.integral_add_adjacent_intervals`; on $[0,1/2]$ rewrite $|(x-\tfrac12)^k| = (\tfrac12 - x)^k$ and substitute $u = \tfrac12 - x$ (`intervalIntegral.integral_comp_sub_left`), on $[1/2,1]$ rewrite to $(x - \tfrac12)^k$ and substitute (`intervalIntegral.integral_comp_sub_right`); both halves equal $\int_0^{1/2} x^k$. -/)
