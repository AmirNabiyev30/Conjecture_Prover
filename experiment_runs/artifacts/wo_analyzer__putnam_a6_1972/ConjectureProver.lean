lemma integral_sum_mul_zero (f : ℝ → ℝ) (k : ℕ) (a : ℕ → ℝ)
    (hfintegrable : IntegrableOn f (Icc (0 : ℝ) 1))
    (hfint : ∀ i : ℕ, i < k → ∫ x in Icc (0 : ℝ) 1, x ^ i * f x = 0) :
    ∫ x in Icc (0 : ℝ) 1, (∑ i ∈ Finset.range k, a i * x ^ i) * f x = 0 := by
