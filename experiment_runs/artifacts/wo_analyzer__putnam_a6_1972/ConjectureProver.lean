lemma integral_abs_shifted_pow_eq_two_mul (k : ℕ) :
    (∫ x in (0 : ℝ)..1, |(x - (1 : ℝ) / 2) ^ k|) =
      2 * (∫ x in (0 : ℝ)..(1 / 2), x ^ k) := by
  have hcont : Continuous (fun x : ℝ => |(x - (1 : ℝ) / 2) ^ k|) := by fun_prop
  calc
    (∫ x in (0 : ℝ)..1, |(x - (1 : ℝ) / 2) ^ k|)
        = (∫ x in (0 : ℝ)..(1 : ℝ) / 2, |(x - (1 : ℝ) / 2) ^ k|) +
          (∫ x in (1 : ℝ) / 2..1, |(x - (1 : ℝ) / 2) ^ k|) := by
            rw [← intervalIntegral.integral_add_adjacent_intervals
              (a := (0 : ℝ)) (b := (1 : ℝ) / 2) (c := (1 : ℝ))
              (f := fun x : ℝ => |(x - (1 : ℝ) / 2) ^ k|)]
            · exact hcont.intervalIntegrable 0 ((1 : ℝ) / 2)
            · exact hcont.intervalIntegrable ((1 : ℝ) / 2) 1
    _ = (∫ x in (0 : ℝ)..(1 : ℝ) / 2, ((1 : ℝ) / 2 - x) ^ k) +
          (∫ x in (1 : ℝ) / 2..1, (x - (1 : ℝ) / 2) ^ k) := by
      congr 1
      · apply intervalIntegral.integral_congr
        intro x hx
        change |(x - (1 : ℝ) / 2) ^ k| = ((1 : ℝ) / 2 - x) ^ k
        have hx_le : x ≤ (1 : ℝ) / 2 := by
          rcases (Set.mem_uIcc.mp hx) with h | h
          · exact h.2
          · exact le_trans h.2 (by norm_num : (0 : ℝ) ≤ (1 : ℝ) / 2)
        have hsub : |x - (1 : ℝ) / 2| = (1 : ℝ) / 2 - x := by
          rw [abs_of_nonpos (sub_nonpos.mpr hx_le)]
          ring
        rw [abs_pow, hsub]
      · apply intervalIntegral.integral_congr
        intro x hx
        change |(x - (1 : ℝ) / 2) ^ k| = (x - (1 : ℝ) / 2) ^ k
        have hx_ge : (1 : ℝ) / 2 ≤ x := by
          rcases (Set.mem_uIcc.mp hx) with h | h
          · exact h.1
          · exact le_trans (by norm_num : (1 : ℝ) / 2 ≤ (1 : ℝ)) h.1
        have hsub : |x - (1 : ℝ) / 2| = x - (1 : ℝ) / 2 := by
          rw [abs_of_nonneg (sub_nonneg.mpr hx_ge)]
        rw [abs_pow, hsub]
    _ = (∫ x in (0 : ℝ)..(1 : ℝ) / 2, x ^ k) +
          (∫ x in (0 : ℝ)..(1 : ℝ) / 2, x ^ k) := by
      congr 1
      · rw [intervalIntegral.integral_comp_sub_left (fun x : ℝ => x ^ k) ((1 : ℝ) / 2)]
        norm_num
      · rw [intervalIntegral.integral_comp_sub_right (fun x : ℝ => x ^ k) ((1 : ℝ) / 2)]
        norm_num
    _ = 2 * (∫ x in (0 : ℝ)..(1 : ℝ) / 2, x ^ k) := by
      ring

